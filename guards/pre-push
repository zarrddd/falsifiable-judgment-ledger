#!/bin/bash
# Full-tree leak gate before any push (fail-closed).
BL="${GUARD_BLOCKLIST:-$HOME/.config/ledger-guard/blocklist.txt}"
cd "$(git rev-parse --show-toplevel)" || exit 1
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done < <(git ls-files -z)
python3 tools/denylist_gate.py --blocklist "$BL" "${FILES[@]}"
