#!/bin/bash
# Leak gate: scan staged files with the private blocklist (fail-closed).
# v0 note: scans worktree content of staged paths; the pre-push full-tree scan is the backstop.
BL="${GUARD_BLOCKLIST:-$HOME/.config/ledger-guard/blocklist.txt}"
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done \
  < <(git diff --cached --name-only --diff-filter=ACM -z)
[ ${#FILES[@]} -eq 0 ] && exit 0
python3 "$(git rev-parse --show-toplevel)/tools/denylist_gate.py" --blocklist "$BL" "${FILES[@]}"
